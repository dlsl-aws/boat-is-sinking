# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Public origin used to build the QR join URL.
# Local dev over LAN: set to http://<your-lan-ip>:3000 so phones can reach it.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
